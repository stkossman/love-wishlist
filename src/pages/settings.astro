---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="SETTINGS / LOVE WISHLIST">
  <main class="mx-auto mb-20 w-full max-w-2xl">
    <header class="collection-heading">
      <h1>Settings</h1>
    </header>
    <fieldset class="preference-options" data-display-preferences>
      <legend class="font-serif text-2xl italic">Collection display</legend>
      <label>
        <input type="radio" name="wishlist-view" value="grid" checked />
        <span>
          <strong>Grid</strong>
          <span>An image-led collection, with room for each wish.</span>
        </span>
      </label>
      <label>
        <input type="radio" name="wishlist-view" value="list" />
        <span>
          <strong>List</strong>
          <span>A compact reading view, with images alongside the details.</span>
        </span>
      </label>
    </fieldset>
    <p class="text-sm leading-relaxed opacity-80">
      Applies to both collections and the combined wishlist in this browser.
    </p>
    <p data-preference-status role="status" class="mt-4 min-h-6 text-sm"></p>
    <noscript>
      <p class="mt-4 text-sm">Enable JavaScript to change and save your display preference.</p>
    </noscript>
  </main>
</Layout>
