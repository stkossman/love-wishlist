---
import Layout from '../layouts/Layout.astro';
import WishlistItemComponent from '../components/WishListItem.astro';
import Button from '../components/ui/Button.astro';
import { db } from "../lib/firebase";
import { collection, getDocs, limit, query, orderBy } from "firebase/firestore";
import type { WishlistItem } from '../data/types';

const q = query(
    collection(db, "items"), 
    orderBy("createdAt", "desc"), 
    limit(20)
);
const querySnapshot = await getDocs(q);

const items: WishlistItem[] = querySnapshot.docs.map((doc) => ({
    id: doc.id,
    ...doc.data()
} as WishlistItem));
---

<Layout title="WISHLIST / INDEX">
    <main class="w-full max-w-2xl mx-auto">
        
        <nav class="flex justify-center gap-4 mb-20 pt-10">
            <Button href="/andrii" variant="outline">Andrii</Button>
            <Button href="/juliette" variant="outline">Juliette</Button>
        </nav>

        <header class="mb-12 text-center">
            <h1 class="font-serif italic text-4xl opacity-80">Latest Additions</h1>
        </header>

        <section class="flex flex-col min-h-[50vh]">
            {items.map((item) => (
                <WishlistItemComponent item={item} />
            ))}
        </section>

        <div class="fixed bottom-10 right-10 z-50">
             <Button href="/add" class="shadow-2xl rounded-full w-14 h-14 !p-0 flex items-center justify-center text-xl">
                +
             </Button>
        </div>

    </main>
</Layout>