---
import Layout from '@/layouts/Layout.astro';
import WishlistItemComponent from '@/components/WishListItem.astro';
import Button from '@/components/ui/Button.astro';
import { Asterisk } from '@lucide/astro';
import HeartLoader from '@/components/HeartLoader.astro';
import { WishlistService } from '@/modules/wishlist/wishlist.service';

const { items, nextCursor } = await WishlistService.getItems();
---

<Layout title="WISHLIST / INDEX">
  <main class="collection-shell mx-auto w-full max-w-[76rem]">
    <header class="collection-heading mb-8 md:mb-10">
      <h1 class="font-serif text-[clamp(2.75rem,5vw,4.5rem)] leading-[1.1] italic">
        Latest Additions
      </h1>
    </header>

    <section
      id="feed-container"
      class="wishlist-feed grid grid-cols-1 items-start gap-x-8 gap-y-11 data-masonry:auto-rows-[4px] data-masonry:gap-y-0 sm:grid-cols-2 lg:grid-cols-3 wishlist-list:mx-auto wishlist-list:max-w-[60rem] wishlist-list:grid-cols-1 wishlist-list:gap-0"
      aria-label="Our wishes"
    >
      {items.map((item) => (
        <WishlistItemComponent item={item} />
      ))}
      <p
        id="empty-message"
        class:list={['col-span-full py-10 text-center opacity-70', items.length > 0 && 'hidden']}
      >
        No wishes yet. Add the first one.
      </p>
    </section>

    <div class="flex items-center justify-center gap-3 py-12">
      <span id="feed-loader" class="hidden">
        <HeartLoader />
      </span>
      {nextCursor && (
        <button
          id="load-more-btn"
          class="border-b border-[var(--color-theme-text)] pb-1 font-mono text-xs tracking-widest uppercase transition-opacity hover:opacity-60 disabled:opacity-30"
          data-cursor={nextCursor}
        >
          Load More
        </button>
      )}
      <p id="end-message" class="hidden font-mono text-xs uppercase opacity-40">
        No more items
      </p>
    </div>

    <div class="fixed right-6 bottom-6 z-50 md:right-10 md:bottom-10">
      <Button
        href="/add"
        class="flex h-14 w-14 items-center justify-center rounded-full !p-0 text-xl shadow-2xl"
      >
        <Asterisk class="h-6 w-6" />
        <span class="sr-only">Add wishlist item</span>
      </Button>
    </div>
  </main>
</Layout>

<script>
  import { WishlistFeedHandler } from '@/modules/wishlist/client/wishlist-feed-handler';

  new WishlistFeedHandler(null);
</script>
