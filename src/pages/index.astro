---
import Layout from '../layouts/Layout.astro';
import WishlistItemComponent from '../components/WishListItem.astro';
import Button from '../components/ui/Button.astro';
import { db } from '../lib/firebase';
import { collection, getDocs, limit, query, orderBy } from 'firebase/firestore';
import type { WishlistItem } from '../data/types';

const pageSize = 6;
const q = query(collection(db, 'items'), orderBy('createdAt', 'desc'), limit(pageSize));
const querySnapshot = await getDocs(q);

const items: WishlistItem[] = querySnapshot.docs.map((doc) => {
  const data = doc.data();
  return {
    id: doc.id,
    ...data,
    createdAt: data.createdAt?.toDate().toISOString(),
  } as WishlistItem;
});

const initialCursor = items.length > 0 ? items[items.length - 1].createdAt : null;
---

<Layout title="WISHLIST / INDEX">
  <main class="mx-auto w-full max-w-2xl">
    <nav class="relative mb-12 flex items-center justify-center gap-4 pt-10 md:mb-20">
      <Button href="/andrii" variant="outline">Andrii</Button>
      <Button href="/juliette" variant="outline">Juliette</Button>
      <Button href="/sizes" variant="outline">Sizes</Button>
    </nav>

    <header class="mb-12 text-center md:mb-24">
      <h1 class="font-serif text-4xl text-[var(--color-theme-text)] italic opacity-80 md:text-6xl">
        Latest Additions
      </h1>
    </header>

    <section id="feed-container" class="flex min-h-[20vh] flex-col">
      {items.map((item) => <WishlistItemComponent item={item} />)}
    </section>

    <div class="flex justify-center py-12">
      {
        items.length === pageSize && (
          <button
            id="load-more-btn"
            class="border-b border-[var(--color-theme-text)] pb-1 font-mono text-xs tracking-widest uppercase transition-opacity hover:opacity-60 disabled:opacity-30"
            data-cursor={initialCursor}
          >
            Load More
          </button>
        )
      }
      <p id="end-message" class="hidden font-mono text-xs uppercase opacity-40">No more items</p>
    </div>

    <div class="fixed right-6 bottom-6 z-50 md:right-10 md:bottom-10">
      <Button
        href="/add"
        class="flex h-14 w-14 items-center justify-center rounded-full !p-0 text-xl shadow-2xl"
      >
        +
      </Button>
    </div>
  </main>
</Layout>

<script>
  import { WishlistFeedHandler } from '../modules/wishlist/wishlist.feed';

  new WishlistFeedHandler(null);
</script>
