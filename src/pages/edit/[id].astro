---
import Layout from '@/layouts/Layout.astro';
import WishlistForm from '@/modules/wishlist/components/forms/WishlistForm.astro';
import { WishlistService } from '@/modules/wishlist/wishlist.service';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/');
}

const item = await WishlistService.getItem(id);

if (!item) {
  return Astro.redirect('/');
}
---

<Layout title={`EDIT / ${item.name.toUpperCase()}`}>
  <WishlistForm mode="update" item={item} />
</Layout>
