---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.astro';
import WishlistDescriptionField from '../../modules/wishlist/components/description/WishlistDescriptionField.astro';
import WishlistImageField from '../../modules/wishlist/components/WishlistImageField.astro';
import { db } from '../../lib/firebase';
import { doc, getDoc } from 'firebase/firestore';
import type { WishlistSpec } from '../../modules/wishlist/wishlist.types';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/');
}

const docRef = doc(db, 'items', id);
const docSnap = await getDoc(docRef);

if (!docSnap.exists()) {
  return Astro.redirect('/');
}

const item = docSnap.data();
const specs: WishlistSpec[] = Array.isArray(item.specs) ? item.specs : [];
---

<Layout title={`EDIT / ${item.name.toUpperCase()}`}>
  <main class="full relative mx-auto mt-4 mb-20 max-w-xl px-4 md:mt-10">
    <div
      id="security-overlay"
      class="fixed inset-0 z-100 flex flex-col items-center justify-center bg-[#f5f5f5] p-4 transition-opacity duration-500"
    >
      <div class="w-full max-w-xs space-y-6 text-center">
        <h2 class="font-serif text-3xl text-[#1a1a1a] italic">Restricted Access</h2>
        <p class="font-mono text-xs tracking-widest uppercase opacity-50">Enter Access Code</p>
        <input
          type="password"
          id="pin-input"
          placeholder="****"
          maxlength="4"
          autofocus
          class="w-full border-b border-[#1a1a1a] bg-transparent py-2 text-center font-serif text-4xl tracking-[0.5em] text-[#1a1a1a] placeholder:opacity-20 focus:outline-none"
        />
        <p id="error-msg" class="font-mono text-xs text-red-700 opacity-0 transition-opacity">
          INVALID CREDENTIALS
        </p>
      </div>
    </div>

    <header class="mb-8 flex items-end justify-between border-b border-[#1a1a1a] pb-4">
      <h1 class="font-serif text-3xl text-[#1a1a1a] italic md:text-4xl">Edit Entry</h1>
      <Button
        href="/"
        variant="outline"
        class="border-opacity-30 !border-[#1a1a1a] px-3 py-1 text-xs !text-[#1a1a1a] hover:!bg-[#1a1a1a] hover:!text-[#f5f5f5]"
      >
        Cancel
      </Button>
    </header>

    <form
      id="edit-item-form"
      class="pointer-events-none flex flex-col gap-8 blur-sm transition-all duration-700 md:gap-12"
      data-id={id}
    >
      <WishlistImageField
        label="Change image"
        imageUrl={item.imageUrl}
        imagePublicId={item.imagePublicId}
        imageWidth={item.imageWidth}
        imageHeight={item.imageHeight}
        imageFormat={item.imageFormat}
        imageBytes={item.imageBytes}
      />

      <div class="flex flex-col gap-4">
        <span class="font-mono text-xs tracking-widest text-[#1a1a1a] uppercase opacity-60"
          >Owner / Beneficiary</span
        >
        <div class="flex gap-8">
          <label class="group flex cursor-pointer items-center gap-3">
            <input
              type="radio"
              name="owner"
              value="me"
              checked={item.owner === 'me'}
              class="h-4 w-4 cursor-pointer accent-[#1a1a1a]"
            />
            <span
              class="font-serif text-xl text-[#1a1a1a] italic transition-opacity group-hover:opacity-70"
              >Andrii</span
            >
          </label>
          <label class="group flex cursor-pointer items-center gap-3">
            <input
              type="radio"
              name="owner"
              value="her"
              checked={item.owner === 'her'}
              class="h-4 w-4 cursor-pointer accent-[#234f1e]"
            />
            <span
              class="font-serif text-xl text-[#1a1a1a] italic transition-opacity group-hover:opacity-70"
              >Juliette</span
            >
          </label>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        <div class="group">
          <label
            for="topic"
            class="mb-2 block font-mono text-xs tracking-widest text-[#1a1a1a] uppercase opacity-60"
            >Topic / Brand</label
          >
          <input
            type="text"
            id="topic"
            name="topic"
            required
            value={item.topic}
            class="w-full border-b border-neutral-400 bg-transparent py-2 font-sans text-[#1a1a1a] transition-colors placeholder:text-neutral-400 focus:border-[#1a1a1a] focus:outline-none"
          />
        </div>

        <div class="group">
          <label
            for="price"
            class="mb-2 block font-mono text-xs tracking-widest text-[#1a1a1a] uppercase opacity-60"
            >Price Estimate</label
          >
          <input
            type="text"
            id="price"
            name="price"
            value={item.price}
            class="w-full border-b border-neutral-400 bg-transparent py-2 font-sans text-[#1a1a1a] transition-colors placeholder:text-neutral-400 focus:border-[#1a1a1a] focus:outline-none"
          />
        </div>
      </div>

      <div class="group">
        <label
          for="name"
          class="mb-2 block font-mono text-xs tracking-widest text-[#1a1a1a] uppercase opacity-60"
          >Item Name</label
        >
        <input
          type="text"
          id="name"
          name="name"
          required
          value={item.name}
          class="w-full border-b border-neutral-400 bg-transparent py-2 font-serif text-3xl text-[#1a1a1a] italic transition-colors placeholder:text-neutral-300 focus:border-[#1a1a1a] focus:outline-none"
        />
      </div>

      <WishlistDescriptionField value={item.description} />

      <div class="group">
        <label
          for="url"
          class="mb-2 block font-mono text-xs tracking-widest text-[#1a1a1a] uppercase opacity-60"
          >Reference URL</label
        >
        <input
          type="url"
          id="url"
          name="url"
          value={item.url}
          class="w-full border-b border-neutral-400 bg-transparent py-2 font-sans text-sm text-[#1a1a1a] transition-colors placeholder:text-neutral-400 focus:border-[#1a1a1a] focus:outline-none"
        />
      </div>

      <div class="flex flex-col gap-5 border-t border-neutral-200 pt-8">
        <div class="flex items-center justify-between">
          <span class="font-mono text-xs tracking-widest text-[#1a1a1a] uppercase opacity-60"
            >Specifications</span
          >
          <button
            type="button"
            id="add-spec-btn"
            class="cursor-pointer font-mono text-xs text-[#1a1a1a] underline transition-opacity hover:no-underline hover:opacity-70"
          >
            + ADD ROW
          </button>
        </div>

        <div id="specs-container" class="space-y-4">
          {
            specs.map((spec) => (
              <div class="spec-row grid grid-cols-[1fr_2fr_auto] items-end gap-4">
                <input
                  type="text"
                  value={spec.label}
                  placeholder="LABEL"
                  class="border-b border-neutral-300 bg-transparent py-1 font-mono text-xs text-[#1a1a1a] uppercase placeholder:text-neutral-400 focus:border-[#1a1a1a] focus:outline-none"
                />
                <input
                  type="text"
                  value={spec.value}
                  placeholder="VALUE"
                  class="border-b border-neutral-300 bg-transparent py-1 text-sm text-[#1a1a1a] placeholder:text-neutral-400 focus:border-[#1a1a1a] focus:outline-none"
                />
                <button
                  type="button"
                  class="remove-spec cursor-pointer pb-1 text-xl leading-none text-neutral-400 transition-colors hover:text-red-700"
                >
                  &times;
                </button>
              </div>
            ))
          }
        </div>
      </div>

      <div class="pt-8">
        <button
          type="submit"
          id="submit-btn"
          class="w-full cursor-pointer bg-[#1a1a1a] py-5 font-sans text-sm tracking-[0.2em] text-[#f5f5f5] uppercase shadow-lg transition-colors hover:bg-neutral-800 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Update Entry
        </button>
      </div>
    </form>
  </main>
</Layout>

<script>
  import { WishlistFormHandler } from '../../modules/wishlist/wishlist.dom';

  new WishlistFormHandler('edit-item-form', 'update');
</script>
