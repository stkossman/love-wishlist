---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
---

<Layout title='404 / NOT FOUND'>
	<main class='w-full flex flex-col items-center justify-center min-h-[60vh] text-center px-4'>
		<h1 class="font-serif italic text-[10rem] md:text-[12rem] leading-none text-[#1a1a1a] opacity-90 select-none">
            404
        </h1>

		<div class="w-24 h-px bg-[#1a1a1a] mb-8 mt-4"></div>

		<div class="space-y-4 mb-16">
            <h2 class="font-mono text-xs md:text-sm uppercase tracking-[0.2em] text-[#1a1a1a]">
                Page Not Found
            </h2>
            <p class="font-serif text-xl md:text-2xl text-[#1a1a1a]/60 max-w-md mx-auto leading-relaxed">
                The item you are looking for is either sold out, moved to the archive, or never existed.
            </p>
        </div>

        <Button href="/" variant="solid" class="!bg-[#1a1a1a] !text-[#f5f5f5] hover:!opacity-80">
            Return to Index
        </Button>
		
	</main>
</Layout>