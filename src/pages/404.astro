---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
---

<Layout title="404 / NOT FOUND">
  <main class="flex min-h-[60vh] w-full flex-col items-center justify-center px-4 text-center">
    <h1
      class="font-serif text-[10rem] leading-none text-[#1a1a1a] italic opacity-90 select-none md:text-[12rem]"
    >
      404
    </h1>

    <div class="mt-4 mb-8 h-px w-24 bg-[#1a1a1a]"></div>

    <div class="mb-16 space-y-4">
      <h2 class="font-mono text-xs tracking-[0.2em] text-[#1a1a1a] uppercase md:text-sm">
        Page Not Found
      </h2>
      <p class="mx-auto max-w-md font-serif text-xl leading-relaxed text-[#1a1a1a]/60 md:text-2xl">
        The item you are looking for is either sold out, moved to the archive, or never existed.
      </p>
    </div>

    <Button href="/" variant="solid" class="!bg-[#1a1a1a] !text-[#f5f5f5] hover:!opacity-80">
      Return to Index
    </Button>
  </main>
</Layout>
