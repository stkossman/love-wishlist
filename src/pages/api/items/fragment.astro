---
import WishlistItemComponent from '@/components/WishListItem.astro';
import { WishlistService } from '@/modules/wishlist/wishlist.service';
import { isOwner } from '@/modules/wishlist/wishlist.utils';

export const partial = true;

const ownerParam = Astro.url.searchParams.get('owner');
const owner = isOwner(ownerParam) ? ownerParam : undefined;
const cursor = Astro.url.searchParams.get('cursor') || undefined;

const { items, nextCursor } = await WishlistService.getItems(owner, cursor);

Astro.response.headers.set('Content-Type', 'text/html; charset=utf-8');
if (nextCursor) {
  Astro.response.headers.set('X-Next-Cursor', nextCursor);
}
---

{items.map((item) => <WishlistItemComponent item={item} isAppended />)}
