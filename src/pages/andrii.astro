---
import Layout from '@/layouts/Layout.astro';
import WishlistItemComponent from '@/components/WishListItem.astro';
import Button from '@/components/ui/Button.astro';
import { WishlistService } from '@/modules/wishlist/wishlist.service';
const { items, nextCursor } = await WishlistService.getItems('me');
---

<Layout title="ANDRII / WISHLIST">
  <style slot="head">
    :root {
      --color-theme-bg: #1a1a1a;
      --color-theme-text: #f5f5f5;
      --color-theme-accent: #c02026;
      --color-theme-border: rgba(245, 245, 245, 0.2);
    }
  </style>

  <main class="mx-auto w-full max-w-2xl">
    <header
      class="border-theme-accent mt-4 mb-12 flex items-end justify-between border-b pb-4 md:mt-10 md:mb-24"
    >
      <div>
        <Button href="/" variant="outline" class="border-opacity-30 mb-6 px-3 py-1 text-xs"
          >← Back</Button
        >
        <h1 class="text-theme-accent font-serif text-4xl italic md:text-6xl">Andrii</h1>
      </div>
      <p class="font-mono text-xs opacity-50">HIS COLLECTION</p>
    </header>

    <section id="feed-container" class="flex flex-col">
      {items.map((item) => <WishlistItemComponent item={item} />)}
      {items.length === 0 && <p class="py-10 text-center opacity-50">No items found.</p>}
    </section>

    <div class="flex justify-center py-12">
      {
        items.length >= 6 && (
          <button
            id="load-more-btn"
            class="border-b border-[var(--color-theme-text)] pb-1 font-mono text-xs tracking-widest uppercase transition-opacity hover:opacity-60 disabled:opacity-30"
            data-cursor={nextCursor}
          >
            Load More
          </button>
        )
      }
      <p id="end-message" class="hidden font-mono text-xs uppercase opacity-40">No more items</p>
    </div>

    <div class="fixed right-6 bottom-6 z-50 md:right-10 md:bottom-10">
      <Button
        href="/add"
        class="!bg-theme-accent flex h-14 w-14 items-center justify-center rounded-full border-none !p-0 text-xl !text-white shadow-2xl shadow-red-900/20"
      >
        +
      </Button>
    </div>
  </main>
</Layout>

<script>
  import { WishlistFeedHandler } from '@/modules/wishlist/wishlist.feed';

  new WishlistFeedHandler('me');
</script>
