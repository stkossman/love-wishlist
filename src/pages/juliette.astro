---
import Layout from '@/layouts/Layout.astro';
import WishlistOwnerFeed from '@/modules/wishlist/components/WishlistOwnerFeed.astro';
import { WishlistService } from '@/modules/wishlist/wishlist.service';
const page = await WishlistService.getItems('her');
---

<Layout title="JULIETTE / WISHLIST">
  <style slot="head">
    :root {
      --color-theme-bg: #234f1e;
      --color-theme-text: #f5f5f5;
      --color-theme-accent: #e6b8af;
      --color-theme-border: rgba(245, 245, 245, 0.2);
    }
  </style>

  <WishlistOwnerFeed owner="her" {...page} />
</Layout>
