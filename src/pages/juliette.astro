---
import Layout from '../layouts/Layout.astro';
import WishlistItemComponent from '../components/WishListItem.astro';
import Button from '../components/ui/Button.astro';
import { db } from '../lib/firebase';
import { collection, getDocs, query, limit, orderBy, where } from 'firebase/firestore';
import type { WishlistItem } from '../data/types';

const pageSize = 6;
const q = query(
  collection(db, 'items'),
  where('owner', '==', 'her'),
  orderBy('createdAt', 'desc'),
  limit(pageSize)
);
const querySnapshot = await getDocs(q);

const items: WishlistItem[] = querySnapshot.docs.map((doc) => {
  const data = doc.data();
  return {
    id: doc.id,
    ...data,
    createdAt: data.createdAt?.toDate().toISOString(),
  } as WishlistItem;
});

const initialCursor = items.length > 0 ? items[items.length - 1].createdAt : null;
---

<Layout title="JULIETTE / WISHLIST">
  <style slot="head">
    :root {
      --color-theme-bg: #234f1e;
      --color-theme-text: #f5f5f5;
      --color-theme-accent: #e6b8af;
      --color-theme-border: rgba(245, 245, 245, 0.2);
    }
  </style>

  <main class="mx-auto w-full max-w-2xl">
    <header
      class="border-theme-accent mt-4 mb-12 flex items-end justify-between border-b pb-4 md:mt-10 md:mb-24"
    >
      <div>
        <Button href="/" variant="outline" class="border-opacity-30 mb-6 px-3 py-1 text-xs"
          >← Back</Button
        >
        <h1 class="text-theme-accent font-serif text-4xl italic md:text-6xl">Juliette</h1>
      </div>
      <p class="font-mono text-xs opacity-50">HER COLLECTION</p>
    </header>

    <section id="feed-container" class="flex flex-col">
      {items.map((item) => <WishlistItemComponent item={item} />)}
      {items.length === 0 && <p class="py-10 text-center opacity-50">No items found.</p>}
    </section>

    <div class="flex justify-center py-12">
      {
        items.length === pageSize && (
          <button
            id="load-more-btn"
            class="border-b border-[var(--color-theme-text)] pb-1 font-mono text-xs tracking-widest uppercase transition-opacity hover:opacity-60 disabled:opacity-30"
            data-cursor={initialCursor}
          >
            Load More
          </button>
        )
      }
      <p id="end-message" class="hidden font-mono text-xs uppercase opacity-40">No more items</p>
    </div>

    <div class="fixed right-6 bottom-6 z-50 md:right-10 md:bottom-10">
      <Button
        href="/add"
        class="!bg-theme-accent !text-theme-bg flex h-14 w-14 items-center justify-center rounded-full border-none !p-0 text-xl shadow-2xl"
      >
        +
      </Button>
    </div>
  </main>
</Layout>

<script>
  import { WishlistFeedHandler } from '../modules/wishlist/wishlist.feed';

  new WishlistFeedHandler('her');
</script>
