---
import Layout from '../layouts/Layout.astro';
import WishlistItemComponent from '../components/WishListItem.astro';
import Button from '../components/ui/Button.astro';
import { db } from '../lib/firebase';
import { collection, getDocs, query, where, orderBy } from 'firebase/firestore';
import type { WishlistItem } from '../data/types';

const q = query(collection(db, 'items'), where('owner', '==', 'her'), orderBy('createdAt', 'desc'));
const querySnapshot = await getDocs(q);
const items = querySnapshot.docs.map((doc) => ({ id: doc.id, ...doc.data() }) as WishlistItem);
---

<Layout title="JULIETTE / WISHLIST">
  <style slot="head">
    :root {
      --color-theme-bg: #234f1e;
      --color-theme-text: #f5f5f5;
      --color-theme-accent: #e6b8af;
      --color-theme-border: rgba(245, 245, 245, 0.2);
    }
  </style>

  <main class="mx-auto w-full max-w-2xl">
    <header
      class="mb-12 md:mb-24 mt-4 md:mt-10 flex items-end justify-between border-b border-[var(--color-theme-accent)] pb-4"
    >
      <div>
        <Button href="/" variant="outline" class="border-opacity-30 mb-6 px-3 py-1 text-xs"
          >← Back</Button
        >
        <h1 class="font-serif italic text-4xl md:text-6xl text-[var(--color-theme-accent)]">Juliette</h1>
      </div>
      <p class="font-mono text-xs opacity-50">HER COLLECTION</p>
    </header>

    <section class="flex flex-col">
      {items.map((item) => <WishlistItemComponent item={item} />)}
      {items.length === 0 && <p class="py-10 text-center opacity-50">No items found.</p>}
    </section>

    <div class="fixed bottom-6 right-6 md:bottom-10 md:right-10 z-50">
      <Button
        href="/add"
        class="flex h-14 w-14 items-center justify-center rounded-full border-none !bg-[var(--color-theme-accent)] !p-0 text-xl !text-[var(--color-theme-bg)] shadow-2xl"
      >
        +
      </Button>
    </div>
  </main>
</Layout>
