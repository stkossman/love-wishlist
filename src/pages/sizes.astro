---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import { ArrowLeft } from '@lucide/astro';
import { sizes, type Person } from '@/data/sizes';
import SizeMeasurements from '@/modules/sizes/SizeMeasurements.astro';
import { SizesRepository } from '@/modules/sizes/sizes.repository';

Astro.response.headers.set('Cache-Control', 'no-store');
const profiles = await Promise.all(
  (['andrii', 'juliette'] as const).map(async (person: Person) => {
    try {
      return { person, measurements: await SizesRepository.find(person), unavailable: false };
    } catch {
      console.error('Could not load measurements for', person);
      return { person, measurements: sizes[person], unavailable: true };
    }
  })
);
---

<Layout title="SIZE GUIDE / SPECS">
  <main class="mx-auto mt-4 mb-20 w-full max-w-4xl md:mt-10">
    <header class="mb-12 flex items-end justify-between border-b border-[#1a1a1a] pb-4">
      <div>
        <h1 class="font-serif text-3xl text-[#1a1a1a] italic md:text-5xl">Specifications</h1>
        <p class="mt-2 font-mono text-[10px] tracking-widest uppercase opacity-50 md:text-xs">
          Body Measurements & Sizing
        </p>
      </div>
      <Button
        href="/"
        variant="outline"
        class="border-opacity-30 !border-[#1a1a1a] px-3 py-1 text-xs !text-[#1a1a1a] hover:!bg-[#1a1a1a] hover:!text-[#f5f5f5]"
      >
        <ArrowLeft class="mr-1 h-4 w-4" />
        Back
      </Button>
    </header>

    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 md:gap-24">
      {profiles.map((profile) => (
        <SizeMeasurements {...profile} />
      ))}
    </div>

    <script>
      import { initSizesEditor } from '@/modules/sizes/sizes-editor';
      document.querySelectorAll<HTMLElement>('[data-sizes-person]').forEach(initSizesEditor);
    </script>
  </main>
</Layout>
