---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import { ArrowLeft } from '@lucide/astro';
import { sizes } from '@/data/sizes';
---

<Layout title="SIZE GUIDE / SPECS">
  <main class="mx-auto mt-4 mb-20 w-full max-w-4xl md:mt-10">
    <header class="mb-12 flex items-end justify-between border-b border-[#1a1a1a] pb-4">
      <div>
        <h1 class="font-serif text-3xl text-[#1a1a1a] italic md:text-5xl">Specifications</h1>
        <p class="mt-2 font-mono text-[10px] tracking-widest uppercase opacity-50 md:text-xs">
          Body Measurements & Sizing
        </p>
      </div>
      <Button
        href="/"
        variant="outline"
        class="border-opacity-30 !border-[#1a1a1a] px-3 py-1 text-xs !text-[#1a1a1a] hover:!bg-[#1a1a1a] hover:!text-[#f5f5f5]"
      >
        <ArrowLeft class="mr-1 h-4 w-4" />
        Back
      </Button>
    </header>

    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 md:gap-24">
      <section class="flex flex-col gap-6">
        <div class="mb-4 flex items-center gap-4">
          <span class="h-2 w-2 rounded-full bg-[#1a1a1a]"></span>
          <h2 class="font-serif text-3xl text-[#1a1a1a] italic">Andrii</h2>
        </div>

        <div class="border-t border-[#1a1a1a]">
          {sizes.andrii.map((item) => (
            <div class="group flex items-end justify-between border-b border-[#1a1a1a]/10 px-2 py-3 transition-colors hover:bg-gray-50">
              <span class="font-mono text-[10px] tracking-widest text-[#1a1a1a]/60 uppercase md:text-xs">
                {item.label}
              </span>
              <div class="flex items-baseline gap-1">
                <span class="font-serif text-xl text-[#1a1a1a]">{item.value}</span>
                {item.unit && (
                  <span class="font-mono text-[10px] text-[#1a1a1a]/40">{item.unit}</span>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="flex flex-col gap-6">
        <div class="mb-4 flex items-center gap-4">
          <span class="h-2 w-2 rounded-full bg-[#234f1e]"></span>
          <h2 class="font-serif text-3xl text-[#234f1e] italic">Juliette</h2>
        </div>

        <div class="border-t border-[#234f1e]">
          {sizes.juliette.map((item) => (
            <div class="group flex items-end justify-between border-b border-[#234f1e]/10 px-2 py-3 transition-colors hover:bg-green-50/30">
              <span class="font-mono text-[10px] tracking-widest text-[#234f1e]/60 uppercase md:text-xs">
                {item.label}
              </span>
              <div class="flex items-baseline gap-1">
                <span class="font-serif text-xl text-[#234f1e]">{item.value}</span>
                {item.unit && (
                  <span class="font-mono text-[10px] text-[#234f1e]/40">{item.unit}</span>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>

    <div class="mt-20 text-center opacity-30">
      <p class="font-serif text-sm italic">Last updated: December 2025</p>
    </div>
  </main>
</Layout>
