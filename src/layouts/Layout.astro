---
import '@/styles/global.css';
import WishlistAccessDialog from '@/modules/wishlist/components/actions/WishlistAccessDialog.astro';
import SiteHeader from '@/components/SiteHeader.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Read before paint: the server renders the same card markup for both views.
      try {
        if (localStorage.getItem('wishlist:view') === 'list')
          document.documentElement.dataset.wishlistView = 'list';
      } catch {}
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <slot name="head" />
  </head>
  <body class="selection:bg-theme-accent selection:text-theme-bg flex min-h-screen flex-col px-4 py-6 md:px-8 md:py-10">
    <a href="#main-content" class="skip-link">
      Skip to content
    </a>
    <SiteHeader />
    <div id="main-content" tabindex="-1">
      <slot />
    </div>
    <WishlistAccessDialog />

    <script>
      import { WishlistCardEvents } from '@/modules/wishlist/client/wishlist-card-events';
      import { initDisplayPreferences } from '@/modules/wishlist/client/wishlist-display-preferences';

      WishlistCardEvents.init();
      initDisplayPreferences();
    </script>
  </body>
</html>
