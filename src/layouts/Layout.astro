---
import '@/styles/global.css';
import WishlistAccessDialog from '@/modules/wishlist/components/actions/WishlistAccessDialog.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <slot name="head" />
  </head>
  <body class="selection:bg-theme-accent selection:text-theme-bg flex min-h-screen flex-col px-4 py-8 md:px-8 md:py-20">
    <slot />
    <WishlistAccessDialog />

    <script>
      import { WishlistCardEvents } from '@/modules/wishlist/client/wishlist-card-events';

      WishlistCardEvents.init();
    </script>
  </body>
</html>
