---
interface Props {
  href: string;
  variant?: 'solid' | 'outline';
  class?: string;
}

const { href, variant = 'solid', class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex cursor-pointer items-center justify-center px-6 py-3 font-sans text-sm tracking-widest uppercase transition-all duration-300',
    variant === 'solid'
      ? 'text-theme-bg bg-(--color-theme-text) hover:opacity-80'
      : 'hover:bg-(--color-theme-text) hover:text-theme-bg border border-(--color-theme-text) text-(--color-theme-text)',
    className,
  ]}
>
  <slot />
</a>
