---
import type { WishlistItem } from '../data/types';

interface Props {
  item: WishlistItem;
}

const { item } = Astro.props;

const ownerLabel = item.owner === 'me' ? 'A' : 'J';
---

<article
  class="group relative flex flex-col gap-3 border-t border-[var(--color-theme-border)] py-5 transition-colors duration-500 ease-out hover:border-[var(--color-theme-text)] md:py-6"
>
  <div class="absolute top-3 right-0 z-20">
    <button
      class="menu-btn flex h-8 w-8 cursor-pointer items-center justify-center rounded-full text-[var(--color-theme-text)] opacity-100 transition-opacity duration-300 hover:bg-[var(--color-theme-text)] hover:text-[var(--color-theme-bg)] active:bg-[var(--color-theme-text)] active:text-[var(--color-theme-bg)] lg:opacity-0 lg:group-hover:opacity-100"
      aria-label="Options"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        fill="currentColor"
        viewBox="0 0 16 16"
      >
        <path
          d="M3 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"
        ></path>
      </svg>
    </button>

    <div
      class="menu-dropdown fade-in absolute right-0 z-30 mt-2 hidden w-32 border border-[#1a1a1a] bg-white py-1 shadow-xl"
    >
      <a
        href={`/edit/${item.id}`}
        class="block w-full px-4 py-3 text-left font-mono text-sm tracking-widest text-[#1a1a1a] uppercase transition-colors hover:bg-[#1a1a1a] hover:text-white md:py-2 md:text-xs"
      >
        Edit
      </a>
      <button
        class="delete-btn block w-full cursor-pointer px-4 py-3 text-left font-mono text-sm tracking-widest text-red-700 uppercase transition-colors hover:bg-red-700 hover:text-white md:py-2 md:text-xs"
        data-id={item.id}
      >
        Delete
      </button>
    </div>
  </div>

  <div
    class="flex items-start justify-between pr-10 font-sans text-[10px] tracking-widest uppercase opacity-60 md:text-xs"
  >
    <div class="flex items-center gap-2 text-[var(--color-theme-text)]">
      <span
        class="flex h-5 w-5 items-center justify-center rounded-full border border-[var(--color-theme-text)] font-serif text-[10px] italic opacity-60"
      >
        {ownerLabel}
      </span>
      <span>{item.topic}</span>
    </div>
  </div>

  <div class="space-y-1">
    <h2
      class="font-serif text-2xl leading-none font-light text-[var(--color-theme-text)] italic md:text-3xl"
    >
      {
        item.url ? (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="underline decoration-[var(--color-theme-border)] decoration-1 underline-offset-4 transition-all hover:decoration-[var(--color-theme-accent)]"
          >
            {item.name}
          </a>
        ) : (
          item.name
        )
      }
    </h2>

    {item.price && <p class="font-sans text-sm font-medium opacity-80">{item.price}</p>}
  </div>

  {
    item.specs && item.specs.length > 0 && (
      <div class="mt-auto grid grid-cols-2 gap-x-4 gap-y-2 pt-3 opacity-80 transition-opacity lg:opacity-60 lg:group-hover:opacity-100">
        {item.specs.map((spec) => (
          <div class="flex flex-col">
            <span class="text-[9px] tracking-wider uppercase opacity-50 md:text-[10px]">
              {spec.label}
            </span>
            <span class="border-b border-[var(--color-theme-border)] pb-1 font-mono text-xs">
              {spec.value}
            </span>
          </div>
        ))}
      </div>
    )
  }
</article>

<script>
  import { doc, deleteDoc } from 'firebase/firestore';
  import { db } from '../lib/firebase';

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const isMenuBtn = target.closest('.menu-btn');
    const isDropdown = target.closest('.menu-dropdown');
    if (!isMenuBtn && !isDropdown) {
      document.querySelectorAll('.menu-dropdown').forEach((el) => el.classList.add('hidden'));
    }
  });

  const menuButtons = document.querySelectorAll('.menu-btn');
  menuButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const dropdown = btn.nextElementSibling as HTMLElement;
      document.querySelectorAll('.menu-dropdown').forEach((el) => {
        if (el !== dropdown) el.classList.add('hidden');
      });
      dropdown.classList.toggle('hidden');
    });
  });

  const deleteButtons = document.querySelectorAll('.delete-btn');
  deleteButtons.forEach((button) => {
    button.addEventListener('click', async (e) => {
      e.stopPropagation();
      if (!confirm('Are you sure you want to delete this item?')) return;

      const btn = e.target as HTMLButtonElement;
      const id = btn.dataset.id;
      const card = btn.closest('article');

      if (!id) return;
      if (card) {
        card.style.opacity = '0.3';
        card.style.pointerEvents = 'none';
      }

      try {
        await deleteDoc(doc(db, 'items', id));
        card?.remove();
      } catch (error) {
        console.error('Error deleting: ', error);
        alert('Error deleting item');
        if (card) {
          card.style.opacity = '1';
          card.style.pointerEvents = 'auto';
        }
      }
    });
  });
</script>
