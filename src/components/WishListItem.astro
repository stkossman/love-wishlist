---
import type { WishlistItem } from '@/modules/wishlist/wishlist.types';
import { getOwnerInitial } from '@/modules/wishlist/wishlist.utils';
import { ArrowUpRight, Ellipsis } from '@lucide/astro';

interface Props {
  item: WishlistItem;
  isAppended?: boolean;
}

const { item, isAppended = false } = Astro.props;
const ownerLabel = getOwnerInitial(item.owner);
---

<article
  class:list={[
    'group relative flex flex-col gap-6 py-8 transition-opacity duration-500 ease-out md:py-10',
    item.imageUrl && 'md:pr-36',
    isAppended && 'animate-fade-in',
  ]}
>
  <div
    class="bg-theme-border group-hover:bg-theme-text absolute top-0 left-0 h-px w-full opacity-20 transition-opacity duration-300 group-hover:opacity-100"
  >
  </div>

  <div class="absolute top-4 right-0 z-20">
    <button
      class="menu-btn text-theme-text hover:bg-theme-text hover:text-theme-bg active:bg-theme-text active:text-theme-bg flex h-8 w-8 cursor-pointer items-center justify-center rounded-full opacity-100 transition-opacity duration-300 lg:opacity-0 lg:group-hover:opacity-100"
      aria-label="Options"
    >
      <Ellipsis class="h-4 w-4" />
    </button>

    <div
      class="menu-dropdown fade-in absolute right-0 z-30 mt-2 hidden w-32 border border-[#1a1a1a] bg-white py-1 shadow-xl"
    >
      <a
        href={`/edit/${item.id}`}
        class="block w-full px-4 py-3 text-left font-mono text-sm tracking-widest text-[#1a1a1a] uppercase transition-colors hover:bg-[#1a1a1a] hover:text-white md:py-2 md:text-xs"
      >
        Edit
      </a>
      <button
        class="delete-btn block w-full cursor-pointer px-4 py-3 text-left font-mono text-sm tracking-widest text-red-700 uppercase transition-colors hover:bg-red-700 hover:text-white md:py-2 md:text-xs"
        data-id={item.id}
      >
        Delete
      </button>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <span
      class="border-theme-text text-theme-text flex h-5 w-5 items-center justify-center rounded-full border font-serif text-[10px] italic opacity-50"
    >
      {ownerLabel}
    </span>

    <span class="text-theme-text font-mono text-[10px] tracking-[0.15em] uppercase opacity-40">
      {item.topic}
    </span>
  </div>

  <div class="flex flex-col gap-1">
    <h2 class="text-theme-text font-serif text-3xl leading-tight font-light italic md:text-4xl">
      {
        item.url ? (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group/link hover:text-theme-accent transition-colors duration-300"
          >
            {item.name}
            <ArrowUpRight class="mb-2 ml-0.5 inline-block h-4 w-4 stroke-[1.5] transition-transform duration-300 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5" />
          </a>
        ) : (
          item.name
        )
      }
    </h2>

    {
      item.price && (
        <p class="text-theme-text mt-1 font-mono text-xs tracking-wide opacity-60">{item.price}</p>
      )
    }
  </div>

  {
    item.specs && item.specs.length > 0 && (
      <div class="mt-2 flex flex-wrap gap-x-8 gap-y-4 opacity-70 transition-opacity lg:opacity-50 lg:group-hover:opacity-100">
        {item.specs.map((spec) => (
          <div class="flex flex-col gap-1">
            <span class="text-theme-text font-mono text-[9px] tracking-widest uppercase opacity-40">
              {spec.label}
            </span>
            <span class="text-theme-text font-mono text-xs">{spec.value}</span>
          </div>
        ))}
      </div>
    )
  }

  {
    item.imageUrl && (
      <div class="border-theme-border mt-1 h-28 w-28 overflow-hidden border opacity-80 transition-opacity md:absolute md:right-0 md:bottom-8 md:mt-0 md:h-32 md:w-24 lg:opacity-70 lg:group-hover:opacity-100">
        <img
          src={item.imageUrl}
          alt={item.name}
          width={item.imageWidth}
          height={item.imageHeight}
          loading="lazy"
          class="h-full w-full object-cover"
        />
      </div>
    )
  }
</article>
