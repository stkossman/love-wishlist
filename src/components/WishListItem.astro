---
import type { WishlistItem } from '../data/types';

interface Props {
  item: WishlistItem;
}

const { item } = Astro.props;

const ownerLabel = item.owner === 'me' ? 'A' : 'J';
---

<article class="group relative flex flex-col gap-3 py-5 md:py-6 border-t border-[var(--color-theme-border)] hover:border-[var(--color-theme-text)] transition-colors duration-500 ease-out">
    
    <div class="absolute top-3 right-0 z-20">
        <button 
            class="menu-btn opacity-100 lg:opacity-0 lg:group-hover:opacity-100 transition-opacity duration-300 text-[var(--color-theme-text)] hover:bg-[var(--color-theme-text)] hover:text-[var(--color-theme-bg)] rounded-full w-8 h-8 flex items-center justify-center cursor-pointer active:bg-[var(--color-theme-text)] active:text-[var(--color-theme-bg)]"
            aria-label="Options"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path d="M3 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/>
            </svg>
        </button>

        <div class="menu-dropdown hidden absolute right-0 mt-2 w-32 bg-white border border-[#1a1a1a] shadow-xl py-1 z-30 fade-in">
            <a href={`/edit/${item.id}`} class="block w-full text-left px-4 py-3 md:py-2 text-sm md:text-xs font-mono uppercase tracking-widest text-[#1a1a1a] hover:bg-[#1a1a1a] hover:text-white transition-colors">
                Edit
            </a>
            <button 
                class="delete-btn block w-full text-left px-4 py-3 md:py-2 text-sm md:text-xs font-mono uppercase tracking-widest text-red-700 hover:bg-red-700 hover:text-white transition-colors cursor-pointer"
                data-id={item.id}
            >
                Delete
            </button>
        </div>
    </div>

    <div class="flex justify-between items-start text-[10px] md:text-xs font-sans tracking-widest opacity-60 uppercase pr-10">
        <div class="flex gap-2 items-center text-[var(--color-theme-text)]">
            <span class="w-5 h-5 flex items-center justify-center border border-[var(--color-theme-text)] text-[10px] rounded-full opacity-60 font-serif italic">
                {ownerLabel}
            </span>
            <span>{item.topic}</span>
        </div>
    </div>

    <div class="space-y-1">
        <h2 class="text-2xl md:text-3xl font-serif italic font-light leading-none text-[var(--color-theme-text)]">
            {item.url ? (
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="underline decoration-1 underline-offset-4 decoration-[var(--color-theme-border)] hover:decoration-[var(--color-theme-accent)] transition-all">
                    {item.name}
                </a>
            ) : (
                item.name
            )}
        </h2>
        
        {item.price && (
            <p class="font-sans text-sm font-medium opacity-80">{item.price}</p>
        )}
    </div>

    {item.specs && item.specs.length > 0 && (
        <div class="mt-auto pt-3 grid grid-cols-2 gap-y-2 gap-x-4 opacity-80 lg:opacity-60 lg:group-hover:opacity-100 transition-opacity">
            {item.specs.map(spec => (
                <div class="flex flex-col">
                    <span class="text-[9px] md:text-[10px] uppercase tracking-wider opacity-50">{spec.label}</span>
                    <span class="text-xs font-mono border-b border-[var(--color-theme-border)] pb-1">{spec.value}</span>
                </div>
            ))}
        </div>
    )}
</article>

<script>
    import { doc, deleteDoc } from "firebase/firestore";
    import { db } from "../lib/firebase";

    document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const isMenuBtn = target.closest('.menu-btn');
        const isDropdown = target.closest('.menu-dropdown');
        if (!isMenuBtn && !isDropdown) {
            document.querySelectorAll('.menu-dropdown').forEach(el => el.classList.add('hidden'));
        }
    });

    const menuButtons = document.querySelectorAll('.menu-btn');
    menuButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const dropdown = btn.nextElementSibling as HTMLElement;
            document.querySelectorAll('.menu-dropdown').forEach(el => {
                if (el !== dropdown) el.classList.add('hidden');
            });
            dropdown.classList.toggle('hidden');
        });
    });

    const deleteButtons = document.querySelectorAll('.delete-btn');
    deleteButtons.forEach(button => {
        button.addEventListener('click', async (e) => {
            e.stopPropagation();
            if (!confirm('Are you sure you want to delete this item?')) return;

            const btn = e.target as HTMLButtonElement;
            const id = btn.dataset.id;
            const card = btn.closest('article');

            if (!id) return;
            if (card) { card.style.opacity = '0.3'; card.style.pointerEvents = 'none'; }

            try {
                await deleteDoc(doc(db, "items", id));
                card?.remove();
            } catch (error) {
                console.error("Error deleting: ", error);
                alert("Error deleting item");
                if (card) { card.style.opacity = '1'; card.style.pointerEvents = 'auto'; }
            }
        });
    });
</script>
