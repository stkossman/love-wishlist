---
import type { WishlistItem } from '@/modules/wishlist/wishlist.types';
import { getOwnerName, getOwnerItemPath } from '@/modules/wishlist/wishlist.utils';
import WishlistItemActions from '@/modules/wishlist/components/actions/WishlistItemActions.astro';
import { ArrowUpRight, Heart } from '@lucide/astro';

interface Props {
  item: WishlistItem;
}
const { item } = Astro.props;
const itemPath = getOwnerItemPath(item.owner, item.id);
---

<article class="wish-card group">
  <WishlistItemActions itemId={item.id} itemName={item.name} />
  <a href={itemPath} class="wish-image" aria-label={`View ${item.name}`}>
    {item.imageUrl ? (
      <img
        src={item.imageUrl}
        alt=""
        width={item.imageWidth}
        height={item.imageHeight}
        loading="lazy"
      />
    ) : (
      <span class="wish-image-fallback" aria-hidden="true">
        <Heart size={48} stroke-width={1} />A wish, still taking shape.
      </span>
    )}
  </a>
  <div class="wish-copy">
    <div class="wish-meta">
      <span>{item.topic}</span>
      <span class="wish-owner">{getOwnerName(item.owner)}</span>
    </div>
    <h2>
      <a href={itemPath}>{item.name}</a>
    </h2>
    {item.price && <p class="wish-price">{item.price}</p>}
    {item.specs && item.specs.length > 0 && (
      <dl class="wish-specs">
        {item.specs.map((spec) => (
          <div>
            <dt>{spec.label}</dt>
            <dd>{spec.value}</dd>
          </div>
        ))}
      </dl>
    )}
    {item.url && (
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class="wish-reference"
        aria-label={`Open reference for ${item.name} (new tab)`}
      >
        Reference <ArrowUpRight size={14} />
      </a>
    )}
  </div>
</article>
