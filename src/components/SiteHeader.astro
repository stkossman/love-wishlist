---
import { Heart } from '@lucide/astro';
const path = Astro.url.pathname;
const owner = path.startsWith('/andrii')
  ? '/andrii'
  : path.startsWith('/juliette')
    ? '/juliette'
    : null;
---

<header class="site-header mx-auto mb-12 w-full max-w-[76rem] md:mb-14">
  <a
    class="site-identity mb-7 inline-block font-serif text-xl italic"
    href="/"
    aria-current={path === '/' ? 'page' : undefined}
  >
    Love Wishlist
    <Heart
      class="ml-1.5 inline-block align-baseline"
      size={14}
      stroke-width={1.5}
      aria-hidden="true"
    />
  </a>
  <div class="site-navigation border-theme-border grid grid-cols-[1fr_auto] gap-5 border-b pb-4 max-[400px]:grid-cols-1 max-[400px]:gap-4 [&_a]:underline-offset-[.35em] [&_a:hover]:underline [&_a[aria-current]]:font-medium [&_a[aria-current]]:underline">
    <nav
      aria-label="Collections"
      class="owner-navigation flex flex-wrap items-baseline gap-3 font-serif text-[1.75rem]"
    >
      <a href="/andrii" aria-current={owner === '/andrii' ? 'page' : undefined}>
        Andrii
      </a>
      <span aria-hidden="true" class="opacity-65">
        /
      </span>
      <a href="/juliette" aria-current={owner === '/juliette' ? 'page' : undefined}>
        Juliette
      </a>
    </nav>
    <nav
      aria-label="Personal reference"
      class="utility-navigation flex flex-wrap items-baseline gap-3 text-xs max-[400px]:row-start-2"
    >
      <a href="/sizes" aria-current={path === '/sizes' ? 'page' : undefined}>
        Sizes
      </a>
      <span aria-hidden="true" class="opacity-65">
        /
      </span>
      <a href="/settings" aria-current={path === '/settings' ? 'page' : undefined}>
        Settings
      </a>
    </nav>
    <nav
      aria-label="Collection view"
      class="collection-navigation col-span-full flex flex-wrap items-baseline gap-6 text-xs max-[400px]:row-start-3"
    >
      <a href={owner ?? '/'} aria-current={path === (owner ?? '/') ? 'page' : undefined}>
        All
      </a>
      <span aria-disabled="true" class="opacity-65">
        For occasions <small class="ml-1.5 text-[.625rem]">Coming later</small>
      </span>
    </nav>
  </div>
</header>
