---
import { Ellipsis } from '@lucide/astro';

interface Props {
  itemId: string;
  itemName?: string;
  redirectTo?: string;
  alwaysVisible?: boolean;
  class?: string;
}

const {
  itemId,
  itemName,
  redirectTo,
  class: className = 'card-actions absolute top-2 right-2 z-2 wishlist-list:top-6',
} = Astro.props;
---

<div class={className}>
  <button
    class="menu-btn border-theme-border bg-theme-bg text-theme-text hover:bg-theme-text hover:text-theme-bg aria-expanded:bg-theme-text aria-expanded:text-theme-bg flex size-11 cursor-pointer items-center justify-center border"
    type="button"
    aria-label={itemName ? `Options for ${itemName}` : 'Item options'}
    aria-expanded="false"
    aria-controls={`item-actions-${itemId}`}
  >
    <Ellipsis class="h-4 w-4" />
  </button>

  <div
    id={`item-actions-${itemId}`}
    class="menu-dropdown absolute top-full right-0 z-30 mt-1.5 hidden w-36 border border-[#1a1a1a] bg-white py-1 shadow-[0_8px_20px_#0002]"
    aria-label="Item actions"
  >
    <a
      href={`/edit/${itemId}`}
      class="block min-h-11 w-full px-4 py-3 text-left font-mono text-sm tracking-widest text-[#1a1a1a] uppercase transition-colors hover:bg-[#1a1a1a] hover:text-white md:py-2 md:text-xs"
    >
      Edit
    </a>
    <button
      class="delete-btn block min-h-11 w-full cursor-pointer px-4 py-3 text-left font-mono text-sm tracking-widest text-red-700 uppercase transition-colors hover:bg-red-700 hover:text-white md:py-2 md:text-xs"
      data-id={itemId}
      data-redirect-to={redirectTo}
    >
      Delete
    </button>
  </div>
</div>
