---
import { Ellipsis } from '@lucide/astro';

interface Props {
  itemId: string;
  itemName?: string;
  redirectTo?: string;
  alwaysVisible?: boolean;
  class?: string;
}

const { itemId, itemName, redirectTo, class: className = 'card-actions' } = Astro.props;
---

<div class={className}>
  <button
    class="menu-btn"
    type="button"
    aria-label={itemName ? `Options for ${itemName}` : 'Item options'}
    aria-expanded="false"
    aria-controls={`item-actions-${itemId}`}
  >
    <Ellipsis class="h-4 w-4" />
  </button>

  <div id={`item-actions-${itemId}`} class="menu-dropdown hidden" aria-label="Item actions">
    <a
      href={`/edit/${itemId}`}
      class="block w-full px-4 py-3 text-left font-mono text-sm tracking-widest text-[#1a1a1a] uppercase transition-colors hover:bg-[#1a1a1a] hover:text-white md:py-2 md:text-xs"
    >
      Edit
    </a>
    <button
      class="delete-btn block w-full cursor-pointer px-4 py-3 text-left font-mono text-sm tracking-widest text-red-700 uppercase transition-colors hover:bg-red-700 hover:text-white md:py-2 md:text-xs"
      data-id={itemId}
      data-redirect-to={redirectTo}
    >
      Delete
    </button>
  </div>
</div>
