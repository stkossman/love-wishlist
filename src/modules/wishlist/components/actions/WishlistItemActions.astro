---
import { Ellipsis, EllipsisVertical } from '@lucide/astro';

interface Props {
  itemId: string;
  itemName?: string;
  redirectTo?: string;
  alwaysVisible?: boolean;
  class?: string;
}

const {
  itemId,
  itemName,
  redirectTo,
  alwaysVisible = false,
  class: className = 'card-actions absolute top-3 left-3 z-2',
} = Astro.props;
const Icon = alwaysVisible ? EllipsisVertical : Ellipsis;
---

<div
  class:list={[
    className,
    !alwaysVisible &&
      'transition-opacity pointer-fine:opacity-0 pointer-fine:group-has-[.wish-media:hover]:opacity-100 pointer-fine:hover:opacity-100 pointer-fine:focus-within:opacity-100 pointer-fine:has-[[aria-expanded=true]]:opacity-100 wishlist-list:opacity-100!',
  ]}
>
  <button
    class:list={[
      'menu-btn flex size-11 cursor-pointer items-center justify-center rounded-full border transition-colors',
      alwaysVisible
        ? 'border-transparent text-theme-text hover:border-current/40 hover:bg-theme-text/5 aria-expanded:border-current/40 aria-expanded:bg-theme-text/5'
        : 'border-transparent bg-black/45 text-white hover:bg-black/60 aria-expanded:bg-black/60',
    ]}
    type="button"
    aria-label={itemName ? `Options for ${itemName}` : 'Item options'}
    aria-expanded="false"
    aria-controls={`item-actions-${itemId}`}
  >
    <Icon class="h-4 w-4" />
  </button>

  <div
    id={`item-actions-${itemId}`}
    class:list={[
      'menu-dropdown absolute top-full z-30 mt-1.5 hidden w-36 border border-[#1a1a1a] bg-white py-1 shadow-[0_8px_20px_#0002]',
      alwaysVisible ? 'right-0' : 'left-0 wishlist-list:right-0 wishlist-list:left-auto',
    ]}
    aria-label="Item actions"
  >
    <a
      href={`/edit/${itemId}`}
      class="block min-h-11 w-full px-4 py-3 text-left font-mono text-sm tracking-widest text-[#1a1a1a] uppercase transition-colors hover:bg-[#1a1a1a] hover:text-white md:py-2 md:text-xs"
    >
      Edit
    </a>
    <button
      class="delete-btn block min-h-11 w-full cursor-pointer px-4 py-3 text-left font-mono text-sm tracking-widest text-red-700 uppercase transition-colors hover:bg-red-700 hover:text-white md:py-2 md:text-xs"
      data-id={itemId}
      data-redirect-to={redirectTo}
    >
      Delete
    </button>
  </div>
</div>
