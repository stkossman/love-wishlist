<dialog
  id="mutation-access-dialog"
  aria-labelledby="mutation-access-title"
  class="fixed inset-0 m-auto w-full max-w-sm border border-[#1a1a1a]/20 bg-[#f5f5f5] p-8 text-center text-[#1a1a1a] backdrop:bg-black/40"
>
  <h2 id="mutation-access-title" class="font-serif text-3xl italic">Restricted Access</h2>
  <label
    for="mutation-pin-input"
    class="mt-6 block font-mono text-xs tracking-widest uppercase opacity-50"
    >Enter Access Code</label
  >
  <input
    id="mutation-pin-input"
    type="password"
    inputmode="numeric"
    autocomplete="off"
    maxlength="4"
    placeholder="****"
    class="mt-4 w-full border-b border-[#1a1a1a] bg-transparent py-2 text-center font-serif text-4xl tracking-[0.5em] focus:outline-none"
  />
  <p data-access-error aria-live="polite" class="mt-4 min-h-8 font-mono text-xs text-red-700"></p>
  <form method="dialog">
    <button class="mt-4 cursor-pointer font-mono text-xs tracking-widest uppercase underline"
      >Cancel</button
    >
  </form>
</dialog>
