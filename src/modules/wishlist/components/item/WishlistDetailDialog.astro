---
import { X } from '@lucide/astro';
import HeartLoader from '@/components/HeartLoader.astro';
---

<dialog
  id="wishlist-detail-dialog"
  aria-label="Wish details"
  class="bg-theme-bg text-theme-text fixed inset-0 m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-5xl overflow-y-auto overscroll-contain p-5 shadow-[0_24px_80px_#0005] backdrop:bg-black/45 sm:p-8 md:p-10"
>
  <div class="mb-6 flex items-center gap-3">
    <span data-detail-owner class="mr-auto font-serif text-lg italic">
      Wish details
    </span>
    <div data-detail-toolbar></div>
    <button
      data-detail-close
      type="button"
      autofocus
      aria-label="Close wish details"
      class="flex size-11 cursor-pointer items-center justify-center rounded-full border border-transparent transition-colors hover:border-current/40 hover:bg-theme-text/5"
    >
      <X size={20} stroke-width={1.5} />
    </button>
  </div>
  <div data-detail-content aria-live="polite"></div>
  <template data-detail-loading>
    <div class="flex min-h-60 items-center justify-center">
      <HeartLoader />
    </div>
  </template>
</dialog>

<style>
  /* The loaded wish registers its two corner marks; the dialog itself never waits. */
  @media (prefers-reduced-motion: no-preference) {
    #wishlist-detail-dialog :global([data-detail-mark] path) {
      animation: register-corner 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    #wishlist-detail-dialog :global([data-detail-mark] path:first-child) {
      --corner-offset: -5px;
    }
    #wishlist-detail-dialog :global([data-detail-mark] path:last-child) {
      --corner-offset: 5px;
    }
  }
  @keyframes register-corner {
    from {
      transform: translate(var(--corner-offset), var(--corner-offset));
      opacity: 0.35;
    }
    to {
      transform: translate(0, 0);
      opacity: 1;
    }
  }
</style>

<script>
  import { initWishlistDetailDialog } from '../../client/wishlist-detail-dialog';
  initWishlistDetailDialog();
</script>
