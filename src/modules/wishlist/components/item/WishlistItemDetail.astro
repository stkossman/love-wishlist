---
import OccasionSummary from '../OccasionSummary.astro';
import Button from '@/components/ui/Button.astro';
import WishlistItemActions from '@/modules/wishlist/components/actions/WishlistItemActions.astro';
import WishlistDescription from '@/modules/wishlist/components/description/WishlistDescription.astro';
import type { WishlistItem } from '@/modules/wishlist/wishlist.types';
import { getOwnerName, getOwnerPath } from '@/modules/wishlist/wishlist.utils';
import { ArrowLeft, ArrowUpRight } from '@lucide/astro';

interface Props {
  item: WishlistItem;
}

const { item } = Astro.props;
const ownerName = getOwnerName(item.owner);
const ownerPath = getOwnerPath(item.owner);
---

<main class="mx-auto w-full max-w-6xl">
  <header class="mt-4 mb-10 flex items-end justify-between md:mt-10 md:mb-16">
    <div>
      <Button href={ownerPath} variant="outline" class="border-opacity-30 mb-6 px-3 py-1 text-xs">
        <ArrowLeft class="mr-1 h-4 w-4" /> Back
      </Button>
      <p class="text-theme-text font-mono text-[10px] tracking-[0.15em] uppercase opacity-40">
        {ownerName} / Wishlist
      </p>
    </div>
    <div class="flex flex-col items-end gap-4">
      <p class="font-mono text-xs opacity-50">ITEM DETAILS</p>
      <WishlistItemActions
        itemId={item.id}
        redirectTo={ownerPath}
        alwaysVisible
        class="relative z-20"
      />
    </div>
  </header>

  <article
    class:list={[
      'grid grid-cols-1 gap-10 md:gap-16',
      item.imageUrl ? 'md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]' : 'md:grid-cols-1',
    ]}
  >
    <section class="flex flex-col gap-8">
      <div class="flex items-center gap-3">
        <span class="border-theme-text text-theme-text flex h-5 w-5 items-center justify-center rounded-full border font-serif text-[10px] italic opacity-50">
          {ownerName[0]}
        </span>
        <span class="text-theme-text font-mono text-[10px] tracking-[0.15em] uppercase opacity-40">
          {item.topic}
        </span>
      </div>

      <div class="flex flex-col gap-3">
        <h1 class="text-theme-text font-serif text-4xl leading-tight break-words font-light italic md:text-6xl">
          {item.name}
        </h1>

        {item.price && (
          <p class="text-theme-text font-mono text-xs tracking-wide opacity-60">{item.price}</p>
        )}
      </div>

      <OccasionSummary occasion={item.occasion} />
      <WishlistDescription description={item.description} />

      {item.specs && item.specs.length > 0 && (
        <div class="grid grid-cols-1 gap-x-10 gap-y-5 pt-4 sm:grid-cols-2">
          {item.specs.map((spec) => (
            <div class="flex flex-col gap-1">
              <span class="text-theme-text font-mono text-[9px] tracking-widest uppercase opacity-40">
                {spec.label}
              </span>
              <span class="text-theme-text font-mono text-sm">{spec.value}</span>
            </div>
          ))}
        </div>
      )}

      {item.url && (
        <div class="pt-2">
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-theme-text hover:text-theme-accent inline-flex items-center font-mono text-xs tracking-widest uppercase transition-colors"
          >
            Open reference
            <ArrowUpRight class="ml-1 h-4 w-4 stroke-[1.5]" />
          </a>
        </div>
      )}
    </section>

    {item.imageUrl && (
      <aside class="bg-theme-text/5 flex min-h-72 items-center justify-center p-5 md:min-h-96">
        <img
          src={item.imageUrl}
          alt={item.name}
          width={item.imageWidth}
          height={item.imageHeight}
          class="max-h-[28rem] w-full object-contain"
        />
      </aside>
    )}
  </article>
</main>
