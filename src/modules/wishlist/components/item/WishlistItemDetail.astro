---
import OccasionSummary from '../OccasionSummary.astro';
import Button from '@/components/ui/Button.astro';
import WishlistItemActions from '@/modules/wishlist/components/actions/WishlistItemActions.astro';
import WishlistDescription from '@/modules/wishlist/components/description/WishlistDescription.astro';
import type { WishlistItem } from '@/modules/wishlist/wishlist.types';
import { getOwnerName, getOwnerPath } from '@/modules/wishlist/wishlist.utils';
import { ArrowLeft } from '@lucide/astro';

interface Props {
  item: WishlistItem;
}

const { item } = Astro.props;
const ownerName = getOwnerName(item.owner);
const ownerPath = getOwnerPath(item.owner);
---

<main
  data-item-detail={item.id}
  data-detail-owner-name={ownerName}
  class="mx-auto w-full max-w-6xl"
>
  <header data-detail-header class="mb-6 flex items-start justify-between gap-4">
    <div data-standalone-only>
      <Button href={ownerPath} variant="outline" class="border-opacity-30 mb-6 px-3 py-1 text-xs">
        <ArrowLeft class="mr-1 h-4 w-4" /> Back
      </Button>
      <p class="text-theme-text font-mono text-[10px] tracking-[0.15em] uppercase opacity-40">
        {ownerName} / Wishlist
      </p>
    </div>
    <div data-detail-actions class="flex flex-col items-end gap-4">
      <WishlistItemActions
        itemId={item.id}
        redirectTo={ownerPath}
        alwaysVisible
        class="relative z-20"
      />
    </div>
  </header>

  <article
    class:list={[
      'grid grid-cols-1 items-start gap-8 md:gap-10',
      item.imageUrl ? 'md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]' : 'md:grid-cols-1',
    ]}
  >
    <section class="flex min-w-0 flex-col gap-8">
      <div class="flex items-center gap-3">
        <svg
          data-detail-mark
          class:list={[
            'text-theme-text size-6 shrink-0 opacity-70',
            item.owner === 'her' && 'rotate-180',
          ]}
          viewBox="0 0 48 48"
          fill="none"
          stroke="currentColor"
          stroke-width="1.25"
          aria-hidden="true"
        >
          <path d="M8 8v13h13" />
          <path d="M27 27h13v13" />
        </svg>
        <span class="text-theme-text font-mono text-[10px] tracking-[0.15em] uppercase opacity-40">
          {item.topic}
        </span>
      </div>

      <div class="flex flex-col gap-3">
        <h1 class="text-theme-text font-serif text-4xl leading-tight break-words font-light italic md:text-5xl">
          {item.name}
        </h1>

        {item.price && (
          <p class="text-theme-text font-mono text-xs tracking-wide opacity-60">{item.price}</p>
        )}
      </div>

      <OccasionSummary occasion={item.occasion} />
      <WishlistDescription
        description={item.description}
        format={item.descriptionFormat}
        referenceUrl={item.url}
      />

      {item.specs && item.specs.length > 0 && (
        <section aria-label="Specifications" class="border-theme-border border-t pt-6">
          <h2 class="mb-5 font-mono text-xs tracking-widest uppercase">Specifications</h2>
          <dl class="grid grid-cols-1 gap-x-10 gap-y-5 sm:grid-cols-2">
            {item.specs.map((spec) => (
              <div class="flex flex-col gap-1">
                <dt class="text-theme-text font-mono text-[10px] tracking-widest uppercase opacity-70">
                  {spec.label}
                </dt>
                <dd class="text-theme-text font-sans text-sm wrap-anywhere">{spec.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}
    </section>

    {item.imageUrl && (
      <aside class="order-first flex items-start justify-center overflow-hidden md:order-last">
        <img
          src={item.imageUrl}
          alt={item.name}
          width={item.imageWidth}
          height={item.imageHeight}
          class="h-auto max-h-[65dvh] w-full object-contain"
        />
      </aside>
    )}
  </article>
</main>
