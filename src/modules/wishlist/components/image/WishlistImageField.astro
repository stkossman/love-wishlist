---
import { imageVersion } from '../../wishlist-image-version';
import { WISHLIST_IMAGE_ACCEPT } from '@/modules/wishlist/constants/image';

interface Props {
  label: string;
  imageUrl?: string;
  imagePublicId?: string;
}

const { label, imageUrl, imagePublicId } = Astro.props;
const hasImage = Boolean(imageUrl);
---

<div
  id="image-upload-field"
  data-image-field
  data-image-version={imageVersion({ imagePublicId, imageUrl })}
  class="flex flex-col items-start gap-3"
  data-initial-image-url={imageUrl ?? ''}
  data-initial-image-public-id={imagePublicId ?? ''}
>
  <input
    id="image-input"
    type="file"
    aria-label={label}
    aria-describedby="image-error"
    accept={WISHLIST_IMAGE_ACCEPT}
    class="peer sr-only"
  />

  <label
    for="image-input"
    class="group flex h-36 w-32 cursor-pointer items-center justify-center overflow-hidden border border-dashed border-[#1a1a1a]/40 bg-transparent text-center transition-colors peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-4 hover:border-[#1a1a1a] md:h-40 md:w-36"
  >
    <img
      id="image-preview"
      src={imageUrl}
      alt=""
      class:list={['h-full w-full object-cover', !hasImage && 'hidden']}
    />
    <span
      id="image-placeholder"
      data-image-placeholder
      class:list={[
        'px-4 font-mono text-[10px] tracking-widest text-[#1a1a1a] uppercase opacity-50 transition-opacity group-hover:opacity-80',
        hasImage && 'hidden',
      ]}
    >
      {label}
    </span>
  </label>

  <div class="flex min-h-4 items-center gap-3">
    <button
      type="button"
      id="clear-image-btn"
      class:list={[
        'cursor-pointer font-mono text-[10px] tracking-widest text-red-700 uppercase underline transition-opacity hover:no-underline hover:opacity-70',
        !hasImage && 'hidden',
      ]}
    >
      Remove image
    </button>
    <p
      id="image-error"
      data-image-error
      aria-live="polite"
      class="font-mono text-[10px] text-red-700 uppercase opacity-0"
    ></p>
  </div>
</div>
