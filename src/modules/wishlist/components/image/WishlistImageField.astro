---
import { WISHLIST_IMAGE_ACCEPT } from '@/modules/wishlist/constants/image';

interface Props {
  label: string;
  imageUrl?: string;
  imagePublicId?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageFormat?: string;
  imageBytes?: number;
}

const { label, imageUrl, imagePublicId, imageWidth, imageHeight, imageFormat, imageBytes } =
  Astro.props;
const hasImage = Boolean(imageUrl);
---

<div
  id="image-upload-field"
  class="flex flex-col items-start gap-3"
  data-initial-image-url={imageUrl ?? ''}
  data-initial-image-public-id={imagePublicId ?? ''}
  data-initial-image-width={imageWidth ?? ''}
  data-initial-image-height={imageHeight ?? ''}
  data-initial-image-format={imageFormat ?? ''}
  data-initial-image-bytes={imageBytes ?? ''}
>
  <input id="image-input" type="file" accept={WISHLIST_IMAGE_ACCEPT} class="sr-only" />

  <label
    for="image-input"
    class="group flex h-36 w-32 cursor-pointer items-center justify-center overflow-hidden border border-dashed border-[#1a1a1a]/40 bg-transparent text-center transition-colors hover:border-[#1a1a1a] md:h-40 md:w-36"
  >
    <img
      id="image-preview"
      src={imageUrl}
      alt=""
      class:list={['h-full w-full object-cover', !hasImage && 'hidden']}
    />
    <span
      id="image-placeholder"
      class:list={[
        'px-4 font-mono text-[10px] tracking-widest text-[#1a1a1a] uppercase opacity-50 transition-opacity group-hover:opacity-80',
        hasImage && 'hidden',
      ]}
    >
      {label}
    </span>
  </label>

  <div class="flex min-h-4 items-center gap-3">
    <button
      type="button"
      id="clear-image-btn"
      class:list={[
        'cursor-pointer font-mono text-[10px] tracking-widest text-red-700 uppercase underline transition-opacity hover:no-underline hover:opacity-70',
        !hasImage && 'hidden',
      ]}
    >
      Remove image
    </button>
    <p id="image-error" class="font-mono text-[10px] text-red-700 uppercase opacity-0">
      Invalid image
    </p>
  </div>
</div>
