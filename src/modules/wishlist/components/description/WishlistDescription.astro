---
import { parseDescriptionSegments } from '@/modules/wishlist/utils/description';

interface Props {
  description?: string;
}

const description = Astro.props.description?.trim();
const segments = description ? parseDescriptionSegments(description) : [];
---

{description && (
  <p class="text-theme-text max-w-2xl font-serif text-xl leading-relaxed whitespace-pre-wrap italic opacity-75 md:text-2xl">
    {segments.map((segment) =>
      segment.type === 'link' ? (
        <a
          href={segment.href}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-theme-accent underline decoration-current/30 underline-offset-4 transition-colors"
        >
          {segment.value}
        </a>
      ) : (
        segment.value
      )
    )}
  </p>
)}
