---
import { renderDescription } from '../../utils/description-renderer';
import type { DescriptionFormat } from '../../wishlist.types';
import { descriptionClasses } from '../../utils/description-styles';
interface Props {
  description?: string;
  format?: DescriptionFormat;
  referenceUrl?: string;
}
const { description, format, referenceUrl } = Astro.props;
const html = renderDescription(description, format, referenceUrl);
---

{html && (
  <section aria-label="Personal notes" class="min-w-0">
    {description?.trim() && (
      <h2 class="mb-4 font-mono text-xs tracking-widest uppercase opacity-70">Personal notes</h2>
    )}
    <div class={descriptionClasses} set:html={html} />
  </section>
)}
