---
import WishlistItemComponent from '@/components/WishListItem.astro';
import Button from '@/components/ui/Button.astro';
import { Asterisk } from '@lucide/astro';
import WishlistFeedPagination from './WishlistFeedPagination.astro';
import OccasionFiltersComponent from './OccasionFilters.astro';
import WishlistOwnerIdentity from './WishlistOwnerIdentity.astro';
import type { OccasionFilters, Owner, WishlistPage } from '../wishlist.types';
import { getOwnerName } from '../wishlist.utils';
interface Props extends WishlistPage {
  owner: Owner | null;
  filters?: OccasionFilters;
}
const { owner, items, nextCursor, filters = {} } = Astro.props;
---

<main
  data-wishlist-feed-root
  data-owner-feed={owner ?? undefined}
  class:list={[
    'collection-shell mx-auto w-full max-w-[76rem]',
    owner && 'xl:grid xl:gap-x-12',
    owner === 'me' && 'xl:grid-cols-[9rem_minmax(0,1fr)]',
    owner === 'her' && 'xl:grid-cols-[minmax(0,1fr)_9rem]',
  ]}
>
  {owner && <WishlistOwnerIdentity owner={owner} />}

  <div class:list={['min-w-0', owner === 'her' && 'xl:col-start-1 xl:row-start-1']}>
    {owner ? (
      <header
        class:list={[
          'collection-heading mb-8 flex flex-wrap items-baseline justify-between gap-4',
          !filters.occasions && 'max-xl:sr-only',
        ]}
      >
        <h2 class="font-serif text-2xl leading-tight font-normal not-italic">
          {filters.occasions ? 'For occasions' : 'Wishes'}
        </h2>
        <p class="text-xs">{getOwnerName(owner)}’s collection</p>
      </header>
    ) : (
      <header class="collection-heading mb-8 flex flex-wrap items-baseline justify-between gap-4 md:mb-10">
        <h1 class="font-serif text-[clamp(2.75rem,5vw,4.5rem)] leading-[1.1] text-[color-mix(in_srgb,var(--color-theme-accent)_80%,var(--color-theme-text))] italic">
          {filters.occasions ? 'For occasions' : 'Latest Additions'}
        </h1>
        <p class="text-xs opacity-75">
          {filters.occasions ? 'Our wishes for celebrations' : 'Her collection of wishes'}
        </p>
      </header>
    )}

    {filters.occasions && <OccasionFiltersComponent filters={filters} />}

    <section
      id="feed-container"
      class="wishlist-feed grid grid-cols-1 items-start gap-x-8 gap-y-11 data-masonry:auto-rows-[4px] data-masonry:gap-y-0 sm:grid-cols-2 lg:grid-cols-3 wishlist-list:mx-auto wishlist-list:max-w-[60rem] wishlist-list:grid-cols-1 wishlist-list:gap-0"
      aria-label={owner ? `${getOwnerName(owner)}’s wishes` : 'Our wishes'}
    >
      {items.map((item) => (
        <WishlistItemComponent item={item} />
      ))}
      <p
        id="empty-message"
        class:list={['col-span-full py-10 text-center opacity-50', items.length > 0 && 'hidden']}
      >
        {filters.occasions ? 'No wishes for these occasions yet.' : 'No items found.'}
      </p>
    </section>

    <WishlistFeedPagination nextCursor={nextCursor} />
  </div>

  <div data-add-entry class="fixed right-6 bottom-6 z-50 md:right-10 md:bottom-10">
    <Button
      href="/add"
      class:list={[
        'group/add !bg-theme-accent focus-visible:outline-theme-text! flex h-14 w-14 items-center justify-center rounded-full border-none !p-0 text-xl shadow-2xl',
        owner === 'me' ? '!text-white shadow-red-900/20' : '!text-theme-bg',
      ]}
    >
      <Asterisk class="h-6 w-6 transition-transform duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] motion-safe:group-focus-visible/add:group-not-active/add:rotate-30 motion-safe:group-active/add:scale-90 motion-safe:group-active/add:rotate-90 motion-safe:group-data-[pressed=true]/add:scale-90 motion-safe:group-data-[pressed=true]/add:rotate-90! motion-safe:[@media(hover:hover)]:group-hover/add:group-not-active/add:rotate-30" />
      <span class="sr-only">Add wishlist item</span>
    </Button>
  </div>
</main>

<script>
  import { WishlistFeedHandler } from '../client/wishlist-feed-handler';
  import { initAddRitual } from '../client/wishlist-add-ritual';
  import { isOwner } from '../wishlist.utils';
  import { readOccasionFilters } from '../occasion';
  document.querySelectorAll<HTMLAnchorElement>('[data-add-entry] a').forEach(initAddRitual);
  const root = document.querySelector('[data-wishlist-feed-root]');
  const owner = root instanceof HTMLElement ? root.dataset.ownerFeed : undefined;
  const params = new URLSearchParams(window.location.search);
  const occasions = window.location.pathname.replace(/\/+$/, '').endsWith('/occasions');
  if (occasions) params.set('collection', 'occasions');
  new WishlistFeedHandler(
    isOwner(owner) ? owner : null,
    occasions ? readOccasionFilters(params) : {}
  );
</script>
