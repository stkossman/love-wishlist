---
import WishlistItemComponent from '@/components/WishListItem.astro';
import Button from '@/components/ui/Button.astro';
import { Asterisk } from '@lucide/astro';
import HeartLoader from '@/components/HeartLoader.astro';
import OccasionFiltersComponent from './OccasionFilters.astro';
import type { OccasionFilters, Owner, WishlistPage } from '../wishlist.types';
import { getOwnerName } from '../wishlist.utils';
interface Props extends WishlistPage {
  owner: Owner | null;
  filters?: OccasionFilters;
}
const { owner, items, nextCursor, filters = {} } = Astro.props;
---

<main
  data-wishlist-feed-root
  data-owner-feed={owner ?? undefined}
  class="collection-shell mx-auto w-full max-w-[76rem]"
>
  <header class="collection-heading mb-8 flex flex-wrap items-baseline justify-between gap-4 md:mb-10">
    <h1 class="font-serif text-[clamp(2.75rem,5vw,4.5rem)] leading-[1.1] text-[color-mix(in_srgb,var(--color-theme-accent)_80%,var(--color-theme-text))] italic">
      {filters.occasions ? 'For occasions' : owner ? getOwnerName(owner) : 'Latest Additions'}
    </h1>
    <p class="text-xs opacity-75">
      {filters.occasions
        ? owner
          ? `${getOwnerName(owner)}’s wishes for celebrations`
          : 'Our wishes for celebrations'
        : owner === 'me'
          ? 'His collection of wishes'
          : 'Her collection of wishes'}
    </p>
  </header>

  {filters.occasions && <OccasionFiltersComponent filters={filters} />}

  <section
    id="feed-container"
    class="wishlist-feed grid grid-cols-1 items-start gap-x-8 gap-y-11 data-masonry:auto-rows-[4px] data-masonry:gap-y-0 sm:grid-cols-2 lg:grid-cols-3 wishlist-list:mx-auto wishlist-list:max-w-[60rem] wishlist-list:grid-cols-1 wishlist-list:gap-0"
    aria-label={owner ? `${getOwnerName(owner)}’s wishes` : 'Our wishes'}
  >
    {items.map((item) => (
      <WishlistItemComponent item={item} />
    ))}
    <p
      id="empty-message"
      class:list={['col-span-full py-10 text-center opacity-50', items.length > 0 && 'hidden']}
    >
      {filters.occasions ? 'No wishes for these occasions yet.' : 'No items found.'}
    </p>
  </section>

  <div class="flex items-center justify-center gap-3 py-12">
    <span id="feed-loader" class="hidden">
      <HeartLoader />
    </span>
    {nextCursor && (
      <button
        id="load-more-btn"
        class="border-b border-[var(--color-theme-text)] pb-1 font-mono text-xs tracking-widest uppercase transition-opacity hover:opacity-60 disabled:opacity-30"
        data-cursor={nextCursor}
      >
        Load More
      </button>
    )}
    <p id="end-message" class="hidden font-mono text-xs uppercase opacity-40">
      No more items
    </p>
  </div>

  <div class="fixed right-6 bottom-6 z-50 md:right-10 md:bottom-10">
    <Button
      href="/add"
      class:list={[
        '!bg-theme-accent flex h-14 w-14 items-center justify-center rounded-full border-none !p-0 text-xl shadow-2xl',
        owner === 'me' ? '!text-white shadow-red-900/20' : '!text-theme-bg',
      ]}
    >
      <Asterisk class="h-6 w-6" />
      <span class="sr-only">Add wishlist item</span>
    </Button>
  </div>
</main>

<script>
  import { WishlistFeedHandler } from '../client/wishlist-feed-handler';
  import { isOwner } from '../wishlist.utils';
  import { readOccasionFilters } from '../occasion';
  const root = document.querySelector('[data-wishlist-feed-root]');
  const owner = root instanceof HTMLElement ? root.dataset.ownerFeed : undefined;
  const params = new URLSearchParams(window.location.search);
  const occasions = window.location.pathname.replace(/\/+$/, '').endsWith('/occasions');
  if (occasions) params.set('collection', 'occasions');
  new WishlistFeedHandler(
    isOwner(owner) ? owner : null,
    occasions ? readOccasionFilters(params) : {}
  );
</script>
