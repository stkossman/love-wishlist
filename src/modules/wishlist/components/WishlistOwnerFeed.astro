---
import WishlistItemComponent from '@/components/WishListItem.astro';
import Button from '@/components/ui/Button.astro';
import { Asterisk } from '@lucide/astro';
import type { Owner, WishlistPage } from '../wishlist.types';
import { getOwnerName } from '../wishlist.utils';
interface Props extends WishlistPage {
  owner: Owner;
}
const { owner, items, nextCursor } = Astro.props;
---

<main data-owner-feed={owner} class="collection-shell mx-auto w-full max-w-[76rem]">
  <header class="collection-heading mb-8 flex flex-wrap items-baseline justify-between gap-4 md:mb-10">
    <h1 class="font-serif text-[clamp(2.75rem,5vw,4.5rem)] leading-[1.1] text-[color-mix(in_srgb,var(--color-theme-accent)_80%,var(--color-theme-text))] italic">
      {getOwnerName(owner)}
    </h1>
    <p class="text-xs opacity-75">
      {owner === 'me' ? 'His collection of wishes' : 'Her collection of wishes'}
    </p>
  </header>

  <section
    id="feed-container"
    class="wishlist-feed grid grid-cols-1 gap-x-8 gap-y-11 sm:grid-cols-2 lg:grid-cols-3 wishlist-list:mx-auto wishlist-list:max-w-[60rem] wishlist-list:grid-cols-1 wishlist-list:gap-0"
    aria-label={`${getOwnerName(owner)}’s wishes`}
  >
    {items.map((item) => (
      <WishlistItemComponent item={item} />
    ))}
    <p
      id="empty-message"
      class:list={['col-span-full py-10 text-center opacity-50', items.length > 0 && 'hidden']}
    >
      No items found.
    </p>
  </section>

  <div class="flex justify-center py-12">
    {nextCursor && (
      <button
        id="load-more-btn"
        class="border-b border-[var(--color-theme-text)] pb-1 font-mono text-xs tracking-widest uppercase transition-opacity hover:opacity-60 disabled:opacity-30"
        data-cursor={nextCursor}
      >
        Load More
      </button>
    )}
    <p id="end-message" class="hidden font-mono text-xs uppercase opacity-40">
      No more items
    </p>
  </div>

  <div class="fixed right-6 bottom-6 z-50 md:right-10 md:bottom-10">
    <Button
      href="/add"
      class:list={[
        '!bg-theme-accent flex h-14 w-14 items-center justify-center rounded-full border-none !p-0 text-xl shadow-2xl',
        owner === 'me' ? '!text-white shadow-red-900/20' : '!text-theme-bg',
      ]}
    >
      <Asterisk class="h-6 w-6" />
      <span class="sr-only">Add wishlist item</span>
    </Button>
  </div>
</main>

<script>
  import { WishlistFeedHandler } from '../client/wishlist-feed-handler';
  import { isOwner } from '../wishlist.utils';
  const root = document.querySelector('[data-owner-feed]');
  const owner = root instanceof HTMLElement ? root.dataset.ownerFeed : undefined;
  if (isOwner(owner)) new WishlistFeedHandler(owner);
</script>
