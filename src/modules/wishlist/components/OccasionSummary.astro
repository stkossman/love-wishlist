---
import type { WishlistOccasion } from '../wishlist.types';
import { occasionName } from '../occasion';
interface Props {
  occasion?: WishlistOccasion;
}
const { occasion } = Astro.props;
---

{occasion && (
  <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs leading-relaxed opacity-80">
    <span>
      {occasionName(occasion)} · {occasion.year}
    </span>
    <span aria-label={`Desire level ${occasion.desire} out of 5`}>♥ {occasion.desire}/5</span>
  </p>
)}
