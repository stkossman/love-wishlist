# Server-only. Generate fresh values; never reuse the previously public PIN.
SECRET_PIN=
# At least 32 random bytes, encoded as base64 or hex.
SESSION_SECRET=

# Dedicated server service account; never prefix these with PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# PEM value; literal \n escapes are supported.
FIREBASE_PRIVATE_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional outbound notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
